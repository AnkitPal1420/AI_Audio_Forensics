*.tmp
*.temp
*.log
~$*

# Audio data: keep the dataset directories empty in version control
dataset/**/*.wav
dataset/**/*.flac
dataset/**/*.mp3
dataset/**/*.ogg
dataset/**/*.m4a
dataset/**/*.aac
dataset/**/*.wma

