# Python environments and packaging
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
build/
dist/
*.egg-info/

# Test, notebook, and tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
